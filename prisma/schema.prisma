generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PrivacyLevel {
  PUBLIC
  NORMAL
  PRIVATE
  OFF
}

enum ConnectionStatus {
  ACTIVE
  DISCONNECTED
  ERROR
  DISABLED
  PENDING
}

enum TradeSide {
  BUY
  SELL
}

enum AlertStatus {
  PENDING
  SENDING
  SENT
  SKIPPED
  FAILED
}

enum BackfillStatus {
  BACKFILL
  NEW
}

enum ProviderDeletionPurpose {
  ACCOUNT_DELETION
  SECRET_REPLACEMENT
}

enum ProviderDeletionStatus {
  REGISTRATION
  READY
  PENDING
  CONFIRMED
}

model User {
  id                  String             @id @default(cuid())
  telegramUserId      String?            @unique
  displayName         String
  /// IANA timezone (e.g. "America/New_York"). Falls back to UTC in alerts when null.
  timeZone            String?
  snaptradeUserId     String?            @unique
  encryptedUserSecret String?
  /// Monotonically increases whenever the mapped SnapTrade user is replaced.
  snaptradeGeneration Int                @default(0)
  /// Durable kill switch. Disconnect and deletion flows turn this off before remote revocation.
  brokerSyncEnabled   Boolean            @default(false)
  /// Non-null once app-account deletion begins; portal flows must never re-enable this user.
  deletionPendingAt   DateTime?
  /// PII-free operator state when deletion cannot be completed automatically.
  deletionBlockReason String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  memberships         GroupMember[]
  brokerConnections   BrokerConnection[]
  tradeEvents         TradeEvent[]
  syncStates          SyncState[]
  auditLogs           AuditLog[]
  providerDeletions   ProviderDeletion[]
}

model Group {
  id                    String        @id @default(cuid())
  telegramChatId        String        @unique
  name                  String?
  inferredAlertsEnabled Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  members               GroupMember[]
  tradeEvents           TradeEvent[]
}

model GroupMember {
  id               String       @id @default(cuid())
  userId           String
  groupId          String
  privacyLevel     PrivacyLevel @default(OFF)
  alertsEnabled    Boolean      @default(false)
  /// Explicit per-group sharing boundary. Orders before this instant must never be routed to the group.
  sharingEnabledAt DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  group            Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
}

model BrokerConnection {
  id              String           @id @default(cuid())
  userId          String
  provider        String           @default("snaptrade")
  authorizationId String           @unique
  brokerageName   String?
  brokerageSlug   String?
  connectionType  String?          @default("read")
  status          ConnectionStatus @default(ACTIVE)
  disabledReason  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  disconnectedAt  DateTime?
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts        BrokerAccount[]

  @@index([userId])
}

model BrokerAccount {
  id                String           @id @default(cuid())
  connectionId      String
  providerAccountId String
  accountNameHash   String?
  accountType       String?
  status            ConnectionStatus @default(ACTIVE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  connection        BrokerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  tradeEvents       TradeEvent[]

  @@unique([connectionId, providerAccountId])
  @@index([providerAccountId])
}

model SyncState {
  id        String   @id @default(cuid())
  userId    String
  accountId String?
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId, key])
}

model TradeEvent {
  id                 String         @id @default(cuid())
  userId             String
  groupId            String?
  accountId          String?
  symbol             String
  side               TradeSide
  quantity           Decimal?
  price              Decimal?
  priceSource        String?
  /// Verbatim price components from the broker for forensic audit and future PnL recomputation.
  averageFillPrice   Decimal?
  executionPrice     Decimal?
  limitPrice         Decimal?
  /// Per-fill commission + exchange fees when surfaced (most brokers expose via activities endpoint).
  fees               Decimal?
  /// Asset class: EQUITY | OPTION | CRYPTO | FOREX | UNKNOWN. Drives multiplier and rendering.
  assetType          String?
  /// Underlying ticker for options (e.g. "AAPL" for an AAPL call).
  underlying         String?
  optionExpiration   DateTime?
  optionStrike       Decimal?
  /// 'CALL' or 'PUT'.
  optionType         String?
  profitLoss         Decimal?
  profitLossPct      Decimal?
  currency           String?        @default("USD")
  tradeTime          DateTime
  rawType            String?
  rawStatus          String?
  rawId              String?
  dedupeHash         String         @unique
  backfillStatus     BackfillStatus @default(NEW)
  alertStatus        AlertStatus    @default(PENDING)
  /// Number of times we've attempted to deliver the alert. Capped by ALERT.MAX_ATTEMPTS.
  alertAttempts      Int            @default(0)
  lastAlertAttemptAt DateTime?
  createdAt          DateTime       @default(now())
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  group              Group?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  account            BrokerAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  alerts             Alert[]

  @@index([userId, tradeTime])
  @@index([alertStatus])
  @@index([groupId, alertStatus])
  @@index([groupId, tradeTime(sort: Desc)])
}

model Alert {
  id           String     @id @default(cuid())
  tradeEventId String
  groupId      String
  platform     String     @default("telegram")
  messageId    String?
  renderedText String
  sentAt       DateTime?
  createdAt    DateTime   @default(now())
  tradeEvent   TradeEvent @relation(fields: [tradeEventId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

/// Durable retry/confirmation handle for SnapTrade's asynchronous user deletion.
/// The provider user ID is never reused, so it is also the lifecycle identity.
model ProviderDeletion {
  provider       String                  @default("snaptrade")
  providerUserId String
  localUserId    String?
  purpose        ProviderDeletionPurpose
  generation     Int
  status         ProviderDeletionStatus  @default(READY)
  requestedAt    DateTime?
  confirmedAt    DateTime?
  lastAttemptAt  DateTime?
  lastError      String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  user           User?                   @relation(fields: [localUserId], references: [id], onDelete: SetNull)

  @@id([provider, providerUserId])
  @@index([localUserId, status])
  @@index([status, lastAttemptAt])
}

/// Durable Telegram long-poll cursor. Webhook mode uses the same scope key so
/// a deployment cannot accidentally replay updates through a fallback poller.
model TelegramUpdateCursor {
  scopeKey     String   @id
  lastUpdateId Int
  updatedAt    DateTime @updatedAt

  @@index([updatedAt])
}

/// Short-lived, keyed deletion boundary for Telegram identities. The raw
/// Telegram ID is never retained; an explicit, newer private /start clears it.
model TelegramIdentitySuppression {
  identityHash       String    @id
  /// Opaque local deletion request id; intentionally has no FK so the boundary
  /// survives deletion of the User row.
  localUserId        String?
  deletedAt          DateTime
  deletionCompletedAt DateTime?
  reactivatedAt      DateTime?
  reactivatedUpdateId Int?
  expiresAt          DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([expiresAt])
  @@index([localUserId])
}

model IdempotencyKey {
  key             String    @id
  /// PROCESSING rows carry a finite lease and can be reclaimed after a crash.
  /// COMPLETED rows are the durable replay boundary.
  status          String
  leaseUntil      DateTime?
  processingToken String?
  completedAt     DateTime?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([expiresAt])
  @@index([status, leaseUntil])
}
